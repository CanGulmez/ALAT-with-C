   def select_module(self):
      """ Select the module and then upload the related operations. """
      self.method_box.clear()
      
      if self.module_box.currentText() == "matrices":
         self.method_box.addItems(ALAT_MATRICES)
      elif self.module_box.currentText() == "vectors":
         self.method_box.addItems(ALAT_VECTORS)
      elif self.module_box.currentText() == "complexes":
         self.method_box.addItems(ALAT_COMPLEXES)
      elif self.module_box.currentText() == "crypts":
         self.method_box.addItems(ALAT_CRYPTS)
      else:
         self.method_box.addItems(ALAT_APPS)
         
      for control_button in self.control_buttons:
         control_button.setEnabled(True)
         
