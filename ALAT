   def calculate_button(self):
      """ Displays the results, when pressing 'calculate' button. """
      module_text = self.module_box.currentText()
      method_text = self.method_box.currentText()

      command = [os.path.abspath("./alat")]
      if module_text == "matrices":
         command.append("matrix")
      elif module_text == "vectors":
         command.append("vector")
      elif module_text == "complexes":
         command.append("complex")
      elif module_text == "crypts":
         command.append("crypt")
      else:
         command.append("app")
      command.append(method_text)
      
      self.results_text += ">>> " + " ".join(command) + " ...\n"
   
      for i in self.visible_set:
         if isinstance(self.parameter_widgets[i], QComboBox):
            command.append(self.parameter_widgets[i].currentText())
         else:
            command.append(self.parameter_widgets[i].text())   

      if method_text in ("zeros", "ones", "identity", "arbitrary",
         "sequential", "random", "uniform", "randint", "reshape", 
         "to_matrix"):
         command[-2] = command[-2] + "," + command[-1]
         command.pop()
      
      try:
         result = subprocess.run(command, capture_output=True, text=True, check=True)
         self.results_text += ">>> " + result.stdout + "\n"
         self.textedit.setText(self.results_text)
      except subprocess.CalledProcessError as error:
         self.results_text += ">>> " + error.stderr + "\n"
         self.textedit.setText(self.results_text)
      
   def save_results_button(self):
      """ Save the results when pressing 'save results' button. """
      fname_max_in = 0
      
      for fname in os.listdir(SAVE_DIR):
         if fname.startswith("alat-result-") and fname.endswith(".txt"):
            if int(fname[12:-4]) > fname_max_in:
               fname_max_in = int(fname[12:-4])
               
      fname = "alat-result-" + str(fname_max_in + 1) + ".txt"
      with open(os.path.join(SAVE_DIR, fname), mode="w+") as file:
         file.write(self.results_text)         
      
   def clear_button(self):
      """ Clear the result completely, when pressing 'clear' button. """
      self.results_text = ""
      self.textedit.clear()
      
   def help_button(self):
      """ Display the help window, when pressing 'help' button. """
      self.help_window.show()
       
if __name__ == "__main__":
   
   app = QApplication(sys.argv)
   
   alat = ALAT()
   alat.show()
   
   sys.exit(app.exec())
